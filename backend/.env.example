# ==============================================================================
# TrueFrame AI — Backend Environment Configuration
# ==============================================================================

# Runtime Environment (development | testing | production)
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Security & CORS (Comma-separated allowed client origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database URL
# Local Development: SQLite
# Production: PostgreSQL (e.g. Neon or Supabase free tier)
DATABASE_URL=sqlite+aiosqlite:///./trueframe_dev.db

# File Storage Configuration
STORAGE_PATH=../storage/temp
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=20
MAX_VIDEO_DURATION_SECONDS=15

# Model Inference Configuration
MODEL_DIR=../models/weights
ACTIVE_MODEL=efficientnet_b0
INFERENCE_DEVICE=cpu
